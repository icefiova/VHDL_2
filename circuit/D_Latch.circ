  <vhdl appearance="logisim_evolution" name="D_Latch">
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity D_Latch is
    Port (
        D   : in  STD_LOGIC;
        en  : in  STD_LOGIC;
        Q   : out STD_LOGIC;
        Qn  : out STD_LOGIC
    );
end D_Latch;

architecture Behavioral of D_Latch is
    signal q_state : STD_LOGIC;
begin

    process(D, en)
    begin
        if en = '1' then
            q_state &lt;= D;
        end if;
    end process;

    Q  &lt;= q_state;
    Qn &lt;= not q_state;

end Behavioral;
</vhdl>
