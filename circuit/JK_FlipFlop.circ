  <vhdl appearance="logisim_evolution" name="JK_FlipFlop">&#13;
library IEEE;&#13;
use IEEE.STD_LOGIC_1164.ALL;&#13;
&#13;
entity JK_FlipFlop is&#13;
    Port (&#13;
        J   : in  STD_LOGIC;&#13;
        K   : in  STD_LOGIC;&#13;
        CLK : in  STD_LOGIC;&#13;
        Q   : out STD_LOGIC;&#13;
        Qn  : out STD_LOGIC&#13;
    );&#13;
end JK_FlipFlop;&#13;
&#13;
architecture Behavioral of JK_FlipFlop is&#13;
    signal q_state : STD_LOGIC;&#13;
begin&#13;
&#13;
    process(CLK)&#13;
    begin&#13;
        if rising_edge(CLK) then&#13;
&#13;
            if J = '0' and K = '0' then&#13;
                null;                 -- Hold&#13;
&#13;
            elsif J = '0' and K = '1' then&#13;
                q_state &lt;= '0';       -- Reset&#13;
&#13;
            elsif J = '1' and K = '0' then&#13;
                q_state &lt;= '1';       -- Set&#13;
&#13;
            elsif J = '1' and K = '1' then&#13;
                q_state &lt;= not q_state; -- Toggle&#13;
&#13;
            end if;&#13;
&#13;
        end if;&#13;
    end process;&#13;
&#13;
    Q  &lt;= q_state;&#13;
    Qn &lt;= not q_state;&#13;
&#13;
end Behavioral;&#13;
</vhdl>
